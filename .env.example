# =================================================================
# CardioTwin AI - Environment Configuration Reference
# =================================================================

# Backend Variables (Render / Production)
PORT=8000
PYTHON_VERSION=3.11.9
CORS_ORIGINS=*
# Optional: Render PostgreSQL connection string (defaults to SQLite bundled database)
# DATABASE_URL=postgresql://user:password@hostname:5432/cardiotwin

# Frontend Variables (Vercel)
# Set VITE_API_URL in your Vercel Project Settings -> Environment Variables
VITE_API_URL=https://cardiotwin-ai-api.onrender.com
